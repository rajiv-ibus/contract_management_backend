# Server
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database (development: contract_management_system_dev)
DATABASE_URL=postgresql://user:password@localhost:5432/contract_management_system_dev
DB_SCHEMA=ibus_cms
# disable | require | verify-full (verify-full needs DB_SSL_CA_PATH, e.g. the DigitalOcean CA certificate)
DB_SSL_MODE=disable
DB_SSL_CA_PATH=

# Auth
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# DigitalOcean Spaces
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# Email: SIMULATED until the iBUS Email API details are shared, then EMAIL_API
EMAIL_PROVIDER=SIMULATED
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=iBUS Contracts <no-reply@example.com>

# Application settings (defaults shown)
INVITE_TTL_HOURS=48
RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_LETTER_AND_NUMBER=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_TTL_HOURS=8
UPLOAD_ALLOWED_TYPES=application/pdf
UPLOAD_MAX_SIZE_MB=25
DOWNLOAD_URL_TTL_MINUTES=5
EMAIL_MAX_ATTEMPTS=5
EMAIL_EVENTS_ENABLED=SUBMITTED,APPROVED,REJECTED,INVALIDATED

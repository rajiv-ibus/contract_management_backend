{
  "name": "contract_management_backend",
  "version": "0.1.0",
  "description": "iBUS Contract Management System backend: maker-checker approval for contract documents.",
  "private": true,
  "engines": {
    "node": ">=26.12.1 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
